# ============================================================
# CyberPs — Investigation Hunter Backend
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
PORT=5174
NODE_ENV=development

# --- MSSQL Database ---
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SERVER=your_sql_server_host
DB_NAME=your_database_name
DB_PORT=1433
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
# Use a strong random string (min 32 chars) in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_strong_random_refresh_secret_min_32_chars
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# --- SMTP / Email ---
SMTP_HOST=smtp.rajasthan.gov.in
SMTP_PORT=465
SMTP_USER=your_email@rajasthan.gov.in
SMTP_PASS=your_email_password

# --- CORS ---
# Comma-separated allowed origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173
